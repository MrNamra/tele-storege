PORT=3000

# Production SQLite database path
DB_FILE=./database/database.sqlite

# Same APP_KEY used for signed media URLs (/s/, /t/, /d/)
APP_KEY=base64:change-me-32-byte-secret-key=

# Shared secret for Immich <-> tele-storage bridge (required only if connecting Immich)
IMMICH_BRIDGE_SECRET=change-me-32-byte-random-secret

# Telegram MTProto credentials (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional: leave blank if logging in interactively via `npm run telegram:login`
# (which saves the session to ./storage/telegram/session.txt)
TELEGRAM_STRING_SESSION=
